#!/usr/bin/env bash
# omarchy-starship-rebuild — Regenerate ~/.config/starship.toml from the current
# omarchy theme's colors.toml so the prompt (used by both bash and fish) follows
# the active theme's color palette as closely as possible.
#
# This script is safe to run on every interactive shell startup: it never blocks
# startup (always exits 0), falls back to omarchy's default starship.toml if the
# theme system or colors.toml is unavailable, and is idempotent.
#
# Substitution map (line context aware via awk):
#   error_symbol   "[✗](bold cyan)" → bold {theme.red}
#   success_symbol "[❯](bold cyan)" → bold {theme.accent}
#   style = "bold cyan"              → bold {theme.light_foreground}
#   style = "italic cyan"            → italic {theme.accent}
#   style = "cyan"                   → {theme.cyan}
#
# User customizations (applied as a sed pass after the theme-color substitution):
#   - Format prefix gains a leading "✟" (Latin cross) styled in bold
#     {theme.foreground}, matching the legacy zsh prompt from
#     terminal-dotfiles/zsh/custom/themes/mytheme.zsh-theme.
#     The cross is preceded by a leading space and the trailing
#     "$character" arrow is stripped (the cross is the only prompt glyph).
#   - A bold {theme.foreground} ">" separator is inserted between the
#     directory and the git branch (no surrounding spaces) so the two read
#     as one logical unit: "<path>><branch>".
#   - The trailing space inside [git_branch].format is stripped so the
#     branch name sits flush against the git_status icon:
#     "<branch><status>" rather than "<branch> <status>".
#   - The [directory] section gets an explicit format = line without a
#     trailing space (overriding starship's default). This way the path
#     sits flush against the ">" separator. The same trailing-space fix
#     is applied to repo_root_format.
#   - The top-level format ends with exactly one trailing space so there
#     is always a single space between the prompt and the cursor —
#     regardless of whether git_status renders anything. Without this,
#     the prompt runs flush into the cursor when no git status is shown.
#     To avoid a double space when a git status IS shown, the git_status
#     icons below are written without a trailing space (see next item).
#   - git_status symbols are replaced with portable Unicode glyphs:
#       conflicted → ✟  (cross)
#       up_to_date → •  (dot)
#       modified   → ⚡  (lightning bolt)
#       untracked  → ?  (question mark; unchanged)
#
# The foreground color is read from the active colors.toml on every
# rebuild, so the cross and ">" automatically follow whatever theme is
# loaded (Nord's #d8dee9, etc.). No hex codes are hardcoded.
#
# This pass is idempotent: the top-level format line is rewritten from
# scratch each run, and the git_status sed patterns are anchored to the
# start of each line.

set -uo pipefail  # no -e: we never want to block fish startup

OUTPUT="$HOME/.config/starship.toml"
BASE="/usr/share/omarchy/config/starship.toml"

# Fallback: copy omarchy's default unchanged. Always exit 0.
fallback() {
    if [ -f "$BASE" ]; then
        cp -f "$BASE" "$OUTPUT"
    fi
    exit 0
}

[ -f "$BASE" ] || exit 0
mkdir -p "$(dirname "$OUTPUT")"

THEME_NAME="$(omarchy theme current 2>/dev/null || echo)"
[ -n "$THEME_NAME" ] || fallback

# `omarchy theme current` returns the display name (e.g. "Future City") but
# `omarchy theme dir` is case-sensitive and expects the dir slug ("future-city").
# Convert display → slug ourselves so the lookup works for user-installed themes
# that have a different dir name than their display name.
THEME_SLUG="$(printf '%s' "$THEME_NAME" | tr '[:upper:] ' '[:lower:]-')"

THEME_DIR=""
for candidate in \
    "$HOME/.config/omarchy/themes/$THEME_SLUG" \
    "$HOME/.config/omarchy/themes/$THEME_NAME" \
    "$OMARCHY_PATH/themes/$THEME_SLUG" \
    "$OMARCHY_PATH/themes/$THEME_NAME"; do
    if [ -f "$candidate/colors.toml" ]; then
        THEME_DIR="$candidate"
        break
    fi
done

[ -n "$THEME_DIR" ] || fallback

COLORS_TOML="$THEME_DIR/colors.toml"

# Extract a theme color value (lines of the form: key = "value").
read_color() {
    grep -E "^${1}[[:space:]]*=" "$COLORS_TOML" 2>/dev/null \
        | head -1 \
        | sed -E 's/^[^=]+=[[:space:]]*"([^"]+)".*/\1/'
}

CYAN="$(read_color cyan)"
RED="$(read_color red)"
LIGHT_FG="$(read_color light_foreground)"
ACCENT="$(read_color accent)"
FOREGROUND="$(read_color foreground)"

# Required for theme-following; if any are missing, fall back to omarchy default.
[ -n "$CYAN" ] || fallback
[ -n "$RED" ] || fallback
[ -n "$LIGHT_FG" ] || fallback
[ -n "$ACCENT" ] || fallback
# foreground is optional for our customizations; fall back to light_foreground.
[ -n "$FOREGROUND" ] || FOREGROUND="$LIGHT_FG"

awk \
    -v text="$LIGHT_FG" \
    -v char="$ACCENT" \
    -v err="$RED" \
    -v status="$CYAN" '
BEGIN { in_directory = 0; dir_style_added = 0 }
/^\[directory\]/ { in_directory = 1; print; next }
in_directory && /^[[:space:]]*$/ && !dir_style_added { in_directory = 0; dir_style_added = 1; print "style = \"bold " text "\""; print; next }
in_directory && /^[^[]/ && !dir_style_added { dir_style_added = 1; print "style = \"bold " text "\""; in_directory = 0 }
in_directory && /^\[/ { in_directory = 0 }

{
    if ($0 ~ /error_symbol[[:space:]]*=/) {
        sub(/bold cyan/, "bold " err)
    } else if ($0 ~ /success_symbol[[:space:]]*=/) {
        sub(/bold cyan/, "bold " char)
    } else if ($0 ~ /style[[:space:]]*=[[:space:]]*"bold cyan"/) {
        sub(/bold cyan/, "bold " text)
    } else if ($0 ~ /style[[:space:]]*=[[:space:]]*"italic cyan"/) {
        sub(/italic cyan/, "italic " char)
    } else if ($0 ~ /style[[:space:]]*=[[:space:]]*"cyan"/) {
        sub(/"cyan"/, "\"" status "\"")
    }
    print
}
' "$BASE" > "$OUTPUT"

# User customizations — applied as an awk + sed pass so they survive every
# rebuild and every theme switch.
#
# 1. Top-level format: rewrite from scratch each run, with the cross prefix,
#    the leading space, the ">" separator, and a single trailing space so
#    there's always exactly one space between the prompt and the cursor.
#    The cross and ">" share the same foreground color so they read as
#    one prompt-chrome pair.
# 2. git_branch format: strip the trailing space before the closing quote so
#    the branch name sits flush against the git_status icon.
# 3. git_status icons: replace the omarchy Nerd Font glyphs with portable
#    Unicode so the prompt reads cleanly on any font. The replacement
#    values intentionally omit a trailing space — the gap before the
#    cursor comes from the top-level format (step 1), not from each
#    icon, so a visible git_status doesn't double the gap.
awk -v cross_color="$FOREGROUND" '
BEGIN { section = "" }
/^\[/ {
    # Track which [section] header we are currently inside (empty for the
    # top-level block before any section header).
    section = $0
    gsub(/[\[\]]/, "", section)
}
section == "" && /^format = / {
    # Top-level format line. Layout:
    #   " " + [✟](bold ACCENT) + " " + [path](style) + [>](bold ACCENT) + [branch+status](style)
    print "format = \" [✟](bold " cross_color ") [$directory]($style)[>](bold " cross_color ")[$git_branch$git_status]($style) \""
    next
}
section == "git_branch" && /^format = / {
    # Drop the trailing space inside the closing quote so the branch name
    # sits flush against the next module (git_status icons).
    sub(/ "$/, "\"")
}
{ print }
' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"

sed -i \
    -e 's|^conflicted = .*|conflicted = "✟"|' \
    -e 's|^up_to_date = .*|up_to_date = "•"|' \
    -e 's|^modified   = .*|modified   = "⚡"|' \
    "$OUTPUT"

# Strip the trailing space inside the closing quote of any format line in
# the [directory] section so the next module (our ">" separator) sits flush
# against the path with no intervening space.
sed -i -E '/^\[directory\]/,/^\[/ s@^(format = "|repo_root_format = ")(.*) "$@\1\2"@' "$OUTPUT"

# Ensure [directory] has an explicit format = line. Starship's built-in
# default ("[$path]($style)[$read_only]($read_only_style) ") has a trailing
# space that we can't strip because it isn't in the config to begin with,
# so we override it. Idempotent: only inserted if no format = line follows
# the [directory] header.
if ! sed -n '/^\[directory\]/,/^\[/{/^format = /p;}' "$OUTPUT" | grep -q '^format = '; then
    sed -i '/^\[directory\]/a\
format = "[$path]($style)[$read_only]($read_only_style)"' "$OUTPUT"
fi
